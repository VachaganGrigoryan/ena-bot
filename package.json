{
  "name": "global-outages",
  "version": "1.0.0",
  "main": "dist/apps/telegram-bot/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:telegram": "tsx watch apps/telegram-bot/main.ts",
    "dev:worker": "tsx watch apps/worker/main.ts",
    "start:telegram": "node dist/apps/telegram-bot/main.js",
    "start:worker": "node dist/apps/worker/main.js",
    "test": "tsx --test tests/**/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "seed:armenia": "tsx packages/storage/seeds/armenia.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/node-schedule": "^2.1.8",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "private": true,
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Global Outages Telegram bot and worker",
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "grammy": "^1.35.0",
    "node-schedule": "^2.1.1",
    "postgres": "^3.4.5"
  }
}
