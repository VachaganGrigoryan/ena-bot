{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "tests/**/*.ts", "drizzle.config.ts"],
  "exclude": ["dist", "node_modules"]
}
